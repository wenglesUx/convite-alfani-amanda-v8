rules_version = '2';

// Regras do Firestore para o site de Álfani & Amanda.
// Cole no Console do Firebase → Firestore Database → Regras → Publicar.
// Os organizadores leem tudo pelo Console (lá as regras não se aplicam) ou pelo painel.
//
// ATENÇÃO: estas regras substituem as atuais do projeto inteiro.
// Se a coleção antiga "presentes" (chá de casa nova) ainda for usada,
// acrescente uma regra para ela antes de publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    // Organizadores que podem entrar no painel (painel.html).
    // Use os MESMOS e-mails cadastrados em Authentication e em config.js.
    function organizador() {
      return request.auth != null
          && request.auth.token.email in ['organizador1@exemplo.com', 'organizador2@exemplo.com'];  // TODO
    }

    // Status público de cada presente: todos leem; só dá para marcar como
    // escolhido uma vez (criar o documento). Ninguém altera nem apaga pelo site.
    match /presentes-casamento-2026/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.disponivel == false
                    && request.resource.data.id is int
                    && request.resource.data.keys().hasOnly(['id', 'item', 'categoria', 'disponivel', 'escolhidoEm']);
      allow update, delete: if false;
    }

    // Quem escolheu o quê (nome + WhatsApp): o site público só grava.
    match /escolhas-presentes-2026/{escolhaId} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'telefone', 'itens', 'criadoEm'])
                    && request.resource.data.nome is string
                    && request.resource.data.telefone.matches('^55[0-9]{10,11}$')
                    && request.resource.data.itens is list
                    && request.resource.data.itens.size() > 0;
      allow read: if organizador();     // só os organizadores leem
      allow update, delete: if false;
    }

    // RSVP: um documento por telefone (o id é o próprio número).
    // "get" permite ao convidado ver a própria resposta; "list" fica bloqueado
    // para ninguém baixar a lista inteira de convidados.
    match /rsvp-casamento-2026/{telefone} {
      allow get: if true;
      allow list: if organizador();      // só o painel lista todas as confirmações
      allow create: if telefone.matches('^55[0-9]{10,11}$')
                    && request.resource.data.telefone == telefone
                    && request.resource.data.presenca in ['sim', 'nao']
                    && request.resource.data.nome is string;
      // só o mesmo nome pode alterar a resposta daquele número
      allow update: if request.resource.data.telefone == telefone
                    && request.resource.data.presenca in ['sim', 'nao']
                    && request.resource.data.nome == resource.data.nome;
      // painel: marcar/desmarcar "lembrado" (não mexe no resto da resposta)
      allow update: if organizador()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lembreteEm', 'lembretePor']);
      allow delete: if false;
    }
  }
}
